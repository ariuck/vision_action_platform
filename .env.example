# 복사해서 .env 로 만든 뒤 값을 바꿔 사용한다. (.env 는 Git에 올리지 않는다)

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL
POSTGRES_DB=vision_action
POSTGRES_USER=vision_action
POSTGRES_PASSWORD=change-me

# 업로드·추론
MAX_UPLOAD_MB=300
AI_REQUEST_TIMEOUT=600
CELERY_TASK_TIME_LIMIT=900
UNCERTAIN_BELOW=0.20
MIN_TRACK_SEC=0.5

# IP Webcam (DroidCam 등). 이름=주소 형식, 여러 대는 쉼표로 구분
# 예) ALLOWED_CAMERAS=phone=http://<휴대폰IP>:4747/video
ALLOWED_CAMERAS=
# 화면에서 카메라를 직접 등록할 때 허용할 IP 대역 (공유기 대역에 맞게, 쉼표로 여러 개)
CAMERA_ALLOWED_NETWORKS=192.168.0.0/16
CAMERA_CAPTURE_SECONDS=8
CAMERA_CONNECT_TIMEOUT=10
